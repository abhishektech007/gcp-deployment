# =============================================================================
# ENVIRONMENT CONFIGURATION BLUEPRINT (.env.example)
# TARGET: Google Cloud Platform (GCP) Production & Staging Environments
# =============================================================================
#
# USAGE INSTRUCTIONS:
#   1. Copy this file to '.env' in your deployment directory:
#      cp .env.example .env
#   2. Substitute all placeholder values with your specific project settings.
#   3. CRITICAL SECURITY NOTICE:
#      Never commit the active '.env' file containing real secrets to Git or
#      any source control repository. Ensure '.env' remains in '.gitignore'.
#
# SECRETS MANAGEMENT STANDARD:
#   In production, sensitive credentials (database passwords, private API keys,
#   encryption keys) should NOT be passed via plain text environment variables.
#   Instead, store them in Google Cloud Secret Manager and mount them into
#   Cloud Run using the '--set-secrets' parameter.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Cloud Platform Foundation Parameters
# -----------------------------------------------------------------------------
# The globally unique identifier of your Google Cloud Project.
# Find this in the Google Cloud Console dashboard or via 'gcloud projects list'.
GCP_PROJECT_ID="your-gcp-project-id"

# Primary geographic region for compute, networking, and storage colocation.
# Common examples: us-central1 (Iowa), us-east1 (S. Carolina), europe-west1 (Belgium)
GCP_REGION="us-central1"

# Primary geographic availability zone for localized zonal resources.
GCP_ZONE="us-central1-a"

# -----------------------------------------------------------------------------
# 2. Google Artifact Registry (Container Image Management)
# -----------------------------------------------------------------------------
# Name of the Docker OCI repository within Google Artifact Registry.
# Created automatically during Phase 2 of 'deploy.sh'.
AR_REPO_NAME="docker-repo"

# Fully qualified hostname for Docker registry API interactions.
# Derived standard: ${GCP_REGION}-docker.pkg.dev
AR_HOSTNAME="us-central1-docker.pkg.dev"

# -----------------------------------------------------------------------------
# 3. Google Cloud Run Backend Service Runtime Settings
# -----------------------------------------------------------------------------
# Cloud Run service identifier used in routing and Google Cloud Logging filters.
CLOUD_RUN_SERVICE_NAME="backend-api"

# Serverless Autoscaling Thresholds:
# Minimum instances:
#   - 0: Scales completely to zero during idle periods (maximizes cost savings).
#   - 1+: Keeps warm instance(s) running 24/7 (eliminates cold-start latency).
CLOUD_RUN_MIN_INSTANCES=0

# Maximum instances:
#   Upper bound cap on autoscaling instances to protect downstream databases
#   and guard against denial-of-wallet cost spikes during traffic surges.
CLOUD_RUN_MAX_INSTANCES=10

# Hardware Compute Quotas per Container Instance:
# Memory options: 256Mi, 512Mi, 1Gi, 2Gi, 4Gi, 8Gi, etc.
CLOUD_RUN_MEMORY="512Mi"

# vCPU allocation: 1, 2, 4, or 8 vCPUs.
CLOUD_RUN_CPU=1

# Maximum simultaneous concurrent HTTP requests allowed per container instance.
# Node.js (event loop) typically handles 80-250 comfortably.
# Python (multi-worker WSGI/ASGI) typically handles 40-100.
CLOUD_RUN_CONCURRENCY=80

# -----------------------------------------------------------------------------
# 4. Frontend Deployment Strategy
# -----------------------------------------------------------------------------
# Selected delivery mechanism for the Angular Single-Page Application (SPA):
#   - "firebase": Deploys to Firebase Hosting CDN (integrated edge routing & SSL).
#   - "gcs"     : Deploys to Google Cloud Storage bucket behind Cloud CDN.
FRONTEND_STRATEGY="firebase"

# -----------------------------------------------------------------------------
# 5. Application Secrets (Use Google Cloud Secret Manager in Production!)
# -----------------------------------------------------------------------------
# Below are examples of credentials required at application runtime.
# For local development: Un-comment and fill in local mock values.
# For Cloud Run production: Store in Secret Manager and map via --set-secrets.
#
# DATABASE_URL="postgresql://dbuser:StrongPassword123@10.0.0.5:5432/production_db"
# API_SECRET_KEY="sec_live_9f834a812e9b46c0"
# JWT_SIGNING_SECRET="super-secure-256-bit-token-string"

# -----------------------------------------------------------------------------
# 6. Observability, Telemetry & Logging
# -----------------------------------------------------------------------------
# Application log severity filter: error, warn, info, http, verbose, debug.
LOG_LEVEL="info"

# Sentry DSN for edge crash reporting and application performance monitoring (APM).
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
